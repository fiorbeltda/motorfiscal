{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fiscal-engine.local/schemas/invariants.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "type", "path", "severity"],
    "properties": {
      "id": {"type": "string", "pattern": "^[A-Z0-9_.-]+$"},
      "type": {"enum": ["REQUIRED_DECISION_PATH"]},
      "path": {"type": "string", "minLength": 1},
      "severity": {"enum": ["INFO", "WARNING", "ACTION_REQUIRED", "BLOCKING"]},
      "effective_from": {"type": "string", "format": "date"},
      "effective_to": {"type": "string", "format": "date"},
      "exempt_when_path": {"type": "string", "minLength": 1},
      "exempt_when_value": {"type": "string", "minLength": 1}
    }
  }
}
