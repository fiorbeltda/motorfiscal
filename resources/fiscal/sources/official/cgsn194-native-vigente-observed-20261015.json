cional, no uso das atribuições que lhe conferem a <a href=\"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp123.htm\" rel=\"nofollow\">Lei Complementar nº 123, de 14 de dezembro de 2006</a>, o <a href=\"https://www.planalto.gov.br/ccivil_03/_ato2007-2010/2007/decreto/d6038.htm\" rel=\"nofollow\">Decreto nº 6.038, de 7 de fevereiro de 2007</a>, e o Regimento Interno aprovado pela <a href=\"http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=138852\" rel=\"nofollow\">Resolução CGSN nº 176, de 19 de junho de 2024</a>, e tendo em vista o disposto no art. 2º, §6º, e art. 16 da <a href=\"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp123.htm\" rel=\"nofollow\">Lei Complementar nº 123, de 14 de dezembro de 2006</a> e no art. 41, §3º e §4º, da <a href=\"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp214.htm#art41\" rel=\"nofollow\">Lei Complementar nº 214, de 16 de janeiro de 2025</a>, resolve:","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":153801,"idSegmento":2737459,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":3,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"Art. 1º A Resolução CGSN nº 186, de 9 de abril de 2026, passa a vigorar com as seguintes alterações:","ancorasOrigem":[],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":153801,"idSegmento":2737460,"versaoSegmento":1,"idTipoSegmento":3,"idAssunto":1,"ordemSegmentoAto":4,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"\"Art. 1º Para o ano-calendário 2027, a opção pelo Regime Especial Unificado de Arrecadação de Tributos e Contribuições devidos pelas Microempresas e Empresas de Pequeno Porte - Simples Nacional, a ser formalizada por meio do Portal do Simples Nacional na internet, deverá ser exercida no período do dia 01 de setembro de 2026 ao dia 15 de outubro de 2026 e produzirá efeitos a partir de 1º de janeiro de 2027. (<a href=\"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp123.htm\" rel=\"nofollow\">Lei Complementar nº 123, de 14 de dezembro de 2006</a>, art. 2º, §6º, e art. 16, caput)","ancorasOrigem":[{"idAto":150653,"idSegmento":2693771,"idAnotacao":300929,"href":"150653","texto":"[Resolução CGSN nº 186, de 09/04/2026 - |Art. 1º Para o ano-calendário 2027, a opção p...| - Alteração]","dataInicioVigencia":"28/09/2026","dataRepublicacao":null,"permiteExcluir":false,"permiteAlterarData":true,"ehAgendamento":false,"textoAgendamento":null,"exibirDataInicioVigencia":true,"permiteAgendamento":true}],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":153801,"idSegmento":2737461,"versaoSegmento":1,"idTipoSegmento":5,"idAssunto":1,"ordemSegmentoAto":5,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"§ 1º A opção de que trata o caput: (<a href=\"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp123.htm\" rel=\"nofollow\">Lei Complementar nº 123, de 2006</a>, art. 2º, § 6º, e art. 16, caput)","ancorasOrigem":[{"idAto":150653,"idSegmento":2693772,"idAnotacao":300930,"href":"150653","texto":"[Resolução CGSN nº 186, de 09/04/2026 - |§ 1º A opção de que trata o caput: (Lei Compl...| - Alteração]","dataInicioVigencia":"28/09/2026","dataRepublicacao":null,"permiteExcluir":false,"permiteAlterarData":true,"ehAgendamento":false,"textoAgendamento":null,"exibirDataInicioVigencia":true,"permiteAgendamento":true}],"ancorasDestino":[],"arquivoBinario":null,"estiloSegmento":null},{"mapper":null,"idAto":153801,"idSegmento":2737462,"versaoSegmento":1,"idTipoSegmento":15,"idAssunto":1,"ordemSegmentoAto":6,"omitir":false,"tachado":false,"original":true,"compilado":true,"agendado":false,"desinenciaTipoSegmento":false,"textoIntegra":"I - poderá ser cancelada pelo solicitante em ca